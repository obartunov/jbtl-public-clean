SELECT w3_mk('intended');
 w3_mk 
-------
 
(1 row)

DELETE FROM m WHERE id=1; VACUUM m;
SELECT 'intended/delete' AS cell, w3_live_chunks('m') AS orphan;
      cell       | orphan 
-----------------+--------
 intended/delete |      0
(1 row)

SELECT w3_mk('intended');
 w3_mk 
-------
 
(1 row)

UPDATE m SET doc=jsonb_set(doc,'{status}','"done"') WHERE id=1; VACUUM m;
SELECT 'intended/update-reuse' AS cell, w3_cold('m') AS cold;
         cell          | cold 
-----------------------+------
 intended/update-reuse | 5000
(1 row)

SELECT w3_mk('intended');
 w3_mk 
-------
 
(1 row)

UPDATE m SET doc=jsonb_set(doc,'{cold}',to_jsonb(repeat('Y',6000))) WHERE id=1; VACUUM m;
SELECT 'intended/update-cold-change' AS cell, w3_cold('m') AS cold;
            cell             | cold 
-----------------------------+------
 intended/update-cold-change | 6000
(1 row)

SELECT w3_mk('intended'); VACUUM FULL m;
 w3_mk 
-------
 
(1 row)

SELECT 'intended/vacuum-full' AS cell, w3_cold('m') AS cold;
         cell         | cold 
----------------------+------
 intended/vacuum-full | 5000
(1 row)

SELECT w3_mk('intended'); REPACK m;
 w3_mk 
-------
 
(1 row)

SELECT 'intended/repack-nonconcurrent' AS cell, w3_cold('m') AS cold;
             cell              | cold 
-------------------------------+------
 intended/repack-nonconcurrent | 5000
(1 row)

-- ====================== BAD external split-parent =======================
