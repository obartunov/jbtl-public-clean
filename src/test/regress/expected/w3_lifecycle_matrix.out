-- ============= BOUNDARY: inline -> external on UPDATE ==================
-- (the premature-free trigger: warm grows past the inline budget while the
--  cold child is reused)
SELECT w3_mk('intended');
 w3_mk 
-------
 
(1 row)

UPDATE m SET doc =
  (SELECT jsonb_object_agg('k'||g, g) FROM generate_series(1,800) g)
  || jsonb_build_object('status','done','cold', repeat('Z',5000))
  WHERE id=1;
VACUUM m;
SELECT 'boundary/inline-to-external' AS cell, w3_cold('m') AS cold;
            cell             | cold 
-----------------------------+------
 boundary/inline-to-external | 5000
(1 row)

-- ============= concurrent REPACK relocates split cold values ===========
-- The concurrent insert path now runs the same toast/relocation logic as
-- non-concurrent rewrite (heap_insert_for_repack -> heap_toast_insert_or_update
-- on nested-external tuples), so concurrent REPACK preserves split jsonb:
-- cold values are recreated in the new toast relation and stay readable.
SELECT w3_mk('intended');
 w3_mk 
-------
 
(1 row)

REPACK (concurrently) m;
SELECT 'intended/repack-concurrent' AS cell, w3_cold('m') AS cold;
            cell            | cold 
----------------------------+------
 intended/repack-concurrent | 5000
(1 row)

SELECT w3_mk('bad');
 w3_mk 
-------
 
(1 row)

REPACK (concurrently) m;
SELECT 'bad/repack-concurrent' AS cell, w3_cold('m') AS cold;
         cell          | cold 
-----------------------+------
 bad/repack-concurrent | 5000
(1 row)

SELECT w3_mk('ordinary');
 w3_mk 
-------
 
(1 row)

REPACK (concurrently) m;
SELECT 'ordinary/repack-concurrent' AS cell, w3_cold('m') AS cold;
            cell            | cold 
----------------------------+------
 ordinary/repack-concurrent | NULL
(1 row)

-- cleanup
DROP TABLE IF EXISTS m;
DROP FUNCTION w3_live_chunks(regclass);
DROP FUNCTION w3_cold(regclass);
DROP FUNCTION w3_mk(text);
