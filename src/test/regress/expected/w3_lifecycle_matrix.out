-- suppress DROP IF EXISTS notices so output is order-independent
SET client_min_messages = warning;
--
-- W3 lifecycle safety-envelope regression matrix.
--
-- Committed evidence for the shape x operation correctness matrix.
-- Self-contained: orphan detection scans the toast relation directly and
-- counts surviving distinct toast valueids, so no C probe is needed and the
-- test is portable.
--
-- Invariant under test: physical varlena shape is NOT semantic split state.
-- An inline split parent whose warm metadata grows can be wholly externalized
-- by the ordinary toast loop while still carrying nested JENTRY_ISTOASTED
-- descriptors.  Lifecycle paths must handle that safely (A-fix); concurrent
-- REPACK must refuse split values (its rewrite mechanism does not relocate
-- cold split values); non-concurrent rewrite must carry split values.
--
-- count of surviving distinct toast valueids for tbl's toast relation
CREATE FUNCTION w3_live_chunks(tbl regclass) RETURNS bigint
LANGUAGE plpgsql AS $$
DECLARE trn text; n bigint;
BEGIN
  SELECT 'pg_toast.' || t.relname INTO trn
  FROM pg_class c JOIN pg_class t ON t.oid = c.reltoastrelid
  WHERE c.oid = tbl;
  IF trn IS NULL THEN RETURN 0; END IF;
  EXECUTE format('SELECT count(DISTINCT chunk_id) FROM %s', trn) INTO n;
  RETURN n;
END$$;
-- read cold field length, capturing any error as text so the script never aborts
CREATE FUNCTION w3_cold(tbl regclass) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE r int;
BEGIN
  EXECUTE format('SELECT length(doc->>''cold'') FROM %s WHERE id=1', tbl) INTO r;
  RETURN coalesce(r::text, 'NULL');
EXCEPTION WHEN OTHERS THEN RETURN 'ERR';
END$$;
-- shape builder
CREATE FUNCTION w3_mk(kind text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  DROP TABLE IF EXISTS m;
  CREATE TABLE m(id int primary key, doc jsonb);
  IF kind = 'ordinary' THEN
    INSERT INTO m VALUES (1, jsonb_build_object('status','run','n',1));
  ELSIF kind = 'intended' THEN
    INSERT INTO m VALUES (1, jsonb_build_object('status','run','cold',repeat('Z',5000)));
  ELSIF kind = 'bad' THEN
    INSERT INTO m SELECT 1,
      (SELECT jsonb_object_agg('k'||g, g) FROM generate_series(1,800) g)
      || jsonb_build_object('cold', repeat('Z',5000));
  END IF;
END$$;
-- ========================= ORDINARY (non-split) =========================
SELECT w3_mk('ordinary');
 w3_mk 
-------
 
(1 row)

DELETE FROM m WHERE id=1; VACUUM m;
SELECT 'ordinary/delete' AS cell, w3_live_chunks('m') AS orphan;
      cell       | orphan 
-----------------+--------
 ordinary/delete |      0
(1 row)

SELECT w3_mk('ordinary');
 w3_mk 
-------
 
(1 row)

UPDATE m SET doc=jsonb_set(doc,'{status}','"done"') WHERE id=1; VACUUM m;
SELECT 'ordinary/update' AS cell, doc->>'status' AS status FROM m WHERE id=1;
      cell       | status 
-----------------+--------
 ordinary/update | done
(1 row)

